[TEMPLATE]
# eVoteGhana - Environment Configuration
# Copy this file to .env and update the values.

# MySQL Database
# In Docker deployments the compose file provisions DB_USER automatically with
# full rights on DB_NAME_MAIN only; keep the root password separate.
DB_HOST=127.0.0.1
DB_USER=evote_app
DB_ROOT_PASSWORD=change-this-root-password
DB_PASSWORD=change-this-app-password
DB_NAME_MAIN=mydb
DB_NAME_IDENTITY=gg
DB_PORT=3306

# Connections reused per worker process; 0 disables pooling.
DB_POOL_SIZE=8

# Vote integrity signing keys, versioned for rotation. Preferred form is JSON:
#   HMAC_KEYS={"k1":"<64 hex chars>","k2":"<64 hex chars>"}
# with HMAC_KEY_VERSION naming the version new ballots must use. Rotate by
# adding a fresh version and moving HMAC_KEY_VERSION forward; old rows keep
# verifying against the version recorded on them.
# Simple deployments may set only the single key below (becomes version k1).
HMAC_KEY_VERSION=k1
HMAC_KEYS=
HMAC_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Issuer label shown inside authenticator apps for admin two factor.
TOTP_ISSUER=eVoteGhana

# Web session signing key (same generation command as above).
# Sessions are invalidated if this changes.
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Session lifetime in seconds
SESSION_MAX_AGE=1800

# Set true when serving over HTTPS (Caddy does this automatically in the Docker deployment)
COOKIE_SECURE=true

# Initial admin account, created automatically on first boot when the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Language: en (English), tw (Twi), ee (Ewe)
LANGUAGE=en

# Reverse proxy domain for the Docker deployment (Caddy auto-TLS)
DOMAIN=vote.example.com

# Host ports mapped to the reverse proxy (change if 80/443 are already in use)
HTTP_PORT=80
HTTPS_PORT=443

# Logging / docs
LOG_LEVEL=INFO
ENABLE_DOCS=false
