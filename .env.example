# eVoteGhana - Environment Configuration
# Copy this file to .env and update the values.

# MySQL Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME_MAIN=mydb
DB_NAME_IDENTITY=gg
DB_PORT=3306

# Vote integrity key (generate a random string: python3 -c "import secrets; print(secrets.token_hex(32))")
HMAC_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Language: en (English), tw (Twi), ee (Ewe)
LANGUAGE=en
